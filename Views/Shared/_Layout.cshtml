<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>@ViewData["Title"] - HFG-N Premium Desk Setup</title>
    
    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="light-mode">
    <!-- Header Navigation -->
    <header class="main-header">
        <div class="header-container">
            <a class="logo-link" asp-controller="Home" asp-action="Index">
                <span class="logo-accent">HFG</span>-N
            </a>
            
            <nav class="main-nav">
                <a class="nav-lnk @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-lnk @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "active" : "")" asp-controller="Home" asp-action="Products">Products</a>
                <a class="nav-lnk @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About Us</a>
            </nav>
            
            <div class="header-actions">
                <!-- Theme Toggle -->
                <button id="theme-toggle" class="icon-btn" aria-label="Toggle Theme">
                    <!-- Sun Icon (Light Mode active, click for dark) -->
                    <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                    <!-- Moon Icon (Dark Mode active, click for light) -->
                    <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>
                
                <!-- Cart Button -->
                <button id="cart-toggle" class="icon-btn cart-btn" aria-label="View Cart">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span id="cart-badge" class="cart-badge">0</span>
                </button>

                <!-- Auth0 Navigation Controls -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    var userName = User.FindFirst("name")?.Value ?? User.Identity?.Name ?? "Account";
                    var userPic = User.FindFirst("picture")?.Value;
                    
                    <div class="user-profile-menu">
                        <button id="user-menu-toggle" class="user-menu-btn" aria-label="User Account Menu">
                            @if (!string.IsNullOrEmpty(userPic))
                            {
                                <img src="@userPic" alt="@userName" class="header-avatar" />
                            }
                            else
                            {
                                <div class="header-avatar-placeholder">
                                    @(string.IsNullOrEmpty(userName) ? "U" : userName.Substring(0, 1).ToUpper())
                                </div>
                            }
                            <span class="user-name-label">@userName</span>
                            <svg class="dropdown-caret" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>

                        <div id="user-dropdown" class="user-dropdown-card">
                            <div class="user-dropdown-header">
                                <strong>@userName</strong>
                                <span class="user-dropdown-email">@(User.FindFirst("email")?.Value ?? "")</span>
                            </div>
                            <hr class="dropdown-divider" />
                            <a asp-controller="Account" asp-action="Profile" class="dropdown-item">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                My Profile
                            </a>
                            <a asp-controller="Account" asp-action="Logout" class="dropdown-item logout-item">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                                Sign Out
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="auth-buttons-group">
                        <!-- Direct Social Login Shortcuts -->
                        <div class="social-login-shortcuts" title="Quick Social Login via Auth0">
                            <a asp-controller="Account" asp-action="Login" asp-route-connection="google-oauth2" class="social-icon-link google-link" title="Sign in with Google">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 15.973 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z"/>
                                </svg>
                            </a>
                            <a asp-controller="Account" asp-action="Login" asp-route-connection="github" class="social-icon-link github-link" title="Sign in with GitHub">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                                </svg>
                            </a>
                        </div>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-secondary btn-sm auth-btn">Sign In</a>
                        <a asp-controller="Account" asp-action="SignUp" class="btn btn-primary btn-sm auth-btn">Sign Up</a>
                    </div>
                }
            </div>
        </div>
    </header>

    <!-- Cart Drawer -->
    <div id="cart-drawer" class="cart-drawer">
        <div class="cart-drawer-backdrop" id="cart-backdrop"></div>
        <div class="cart-drawer-content">
            <div class="cart-drawer-header">
                <h3>Your Cart</h3>
                <button id="cart-close" class="close-btn" aria-label="Close Cart">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            
            <div class="cart-drawer-items" id="cart-items-container">
                <!-- Dynamically filled with JS -->
                <div class="empty-cart-message">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-cart-icon">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <p>Your cart is empty.</p>
                    <a asp-controller="Home" asp-action="Products" class="btn btn-primary btn-sm">Browse Products</a>
                </div>
            </div>
            
            <div class="cart-drawer-footer">
                <div class="cart-summary-row">
                    <span>Subtotal</span>
                    <span id="cart-subtotal">$0.00</span>
                </div>
                <button id="checkout-btn" class="btn btn-primary btn-block">Proceed to Checkout</button>
            </div>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast-container" class="toast-container"></div>

    <!-- Main Content Area -->
    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <a class="logo-link" asp-controller="Home" asp-action="Index">
                    <span class="logo-accent">HFG</span>-N
                </a>
                <p class="footer-tagline">Crafting tactile aesthetics for premium work environments.</p>
            </div>
            <div class="footer-links">
                <h4>Navigation</h4>
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="Products">Products</a>
                <a asp-controller="Home" asp-action="About">About Us</a>
            </div>
            <div class="footer-newsletter">
                <h4>Stay Updated</h4>
                <p>Subscribe to receive product drops and workspace inspiration.</p>
                <form id="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing!'); this.reset();">
                    <input type="email" placeholder="Your email address" required />
                    <button type="submit" class="btn btn-secondary">Join</button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year HFG-N. All rights reserved. Created in ASP.NET Core & C#.</p>
        </div>
    </footer>

    <!-- Custom site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
