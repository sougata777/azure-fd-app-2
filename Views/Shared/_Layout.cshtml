<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>@ViewData["Title"] - HFG-N Premium Desk Setup</title>
    
    <!-- Google Fonts: Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Custom site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="light-mode">
    <!-- Header Navigation -->
    <header class="main-header">
        <div class="header-container">
            <a class="logo-link" asp-controller="Home" asp-action="Index">
                <span class="logo-accent">HFG</span>-N
            </a>
            
            <nav class="main-nav">
                <a class="nav-lnk @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-lnk @(ViewContext.RouteData.Values["action"]?.ToString() == "Products" ? "active" : "")" asp-controller="Home" asp-action="Products">Products</a>
                <a class="nav-lnk @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About Us</a>
            </nav>
            
            <div class="header-actions">
                <!-- Auth0 Authentication Links & Controls -->
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    var userAvatar = User.FindFirst("picture")?.Value ?? "https://cdn.auth0.com/avatars/default.png";
                    var userName = User.Identity?.Name ?? "Account";
                    <div class="user-auth-menu">
                        <a asp-controller="Account" asp-action="Profile" class="user-profile-btn" title="View Profile">
                            <img src="@userAvatar" alt="@userName" class="header-avatar" onerror="this.src='https://cdn.auth0.com/avatars/default.png';" />
                            <span class="header-user-name">@userName</span>
                        </a>
                        <a asp-controller="Account" asp-action="Logout" class="auth-btn auth-btn-logout" title="Sign Out">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                            <span>Logout</span>
                        </a>
                    </div>
                }
                else
                {
                    <div class="user-auth-menu">
                        <div class="social-quick-login" title="Social Login Options">
                            <a asp-controller="Account" asp-action="Login" asp-route-connection="google-oauth2" class="social-icon-link google" title="Sign in with Google">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/></svg>
                            </a>
                            <a asp-controller="Account" asp-action="Login" asp-route-connection="github" class="social-icon-link github" title="Sign in with GitHub">
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/></svg>
                            </a>
                        </div>
                        <a asp-controller="Account" asp-action="Login" class="auth-btn auth-btn-login">Sign In</a>
                        <a asp-controller="Account" asp-action="SignUp" class="auth-btn auth-btn-signup">Register</a>
                    </div>
                }

                <!-- Theme Toggle -->
                <button id="theme-toggle" class="icon-btn" aria-label="Toggle Theme">
                    <!-- Sun Icon (Light Mode active, click for dark) -->
                    <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="5"></circle>
                        <line x1="12" y1="1" x2="12" y2="3"></line>
                        <line x1="12" y1="21" x2="12" y2="23"></line>
                        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                        <line x1="1" y1="12" x2="3" y2="12"></line>
                        <line x1="21" y1="12" x2="23" y2="12"></line>
                        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                    </svg>
                    <!-- Moon Icon (Dark Mode active, click for light) -->
                    <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                    </svg>
                </button>
                
                <!-- Cart Button -->
                <button id="cart-toggle" class="icon-btn cart-btn" aria-label="View Cart">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <span id="cart-badge" class="cart-badge">0</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Cart Drawer -->
    <div id="cart-drawer" class="cart-drawer">
        <div class="cart-drawer-backdrop" id="cart-backdrop"></div>
        <div class="cart-drawer-content">
            <div class="cart-drawer-header">
                <h3>Your Cart</h3>
                <button id="cart-close" class="close-btn" aria-label="Close Cart">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            
            <div class="cart-drawer-items" id="cart-items-container">
                <!-- Dynamically filled with JS -->
                <div class="empty-cart-message">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="empty-cart-icon">
                        <circle cx="9" cy="21" r="1"></circle>
                        <circle cx="20" cy="21" r="1"></circle>
                        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
                    </svg>
                    <p>Your cart is empty.</p>
                    <a asp-controller="Home" asp-action="Products" class="btn btn-primary btn-sm">Browse Products</a>
                </div>
            </div>
            
            <div class="cart-drawer-footer">
                <div class="cart-summary-row">
                    <span>Subtotal</span>
                    <span id="cart-subtotal">$0.00</span>
                </div>
                <button id="checkout-btn" class="btn btn-primary btn-block">Proceed to Checkout</button>
            </div>
        </div>
    </div>

    <!-- Notification Toast -->
    <div id="toast-container" class="toast-container"></div>

    <!-- Main Content Area -->
    <main role="main" class="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-brand">
                <a class="logo-link" asp-controller="Home" asp-action="Index">
                    <span class="logo-accent">HFG</span>-N
                </a>
                <p class="footer-tagline">Crafting tactile aesthetics for premium work environments.</p>
            </div>
            <div class="footer-links">
                <h4>Navigation</h4>
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Home" asp-action="Products">Products</a>
                <a asp-controller="Home" asp-action="About">About Us</a>
            </div>
            <div class="footer-newsletter">
                <h4>Stay Updated</h4>
                <p>Subscribe to receive product drops and workspace inspiration.</p>
                <form id="newsletter-form" onsubmit="event.preventDefault(); alert('Thank you for subscribing!'); this.reset();">
                    <input type="email" placeholder="Your email address" required />
                    <button type="submit" class="btn btn-secondary">Join</button>
                </form>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; @DateTime.Now.Year HFG-N. All rights reserved. Created in ASP.NET Core & C#.</p>
        </div>
    </footer>

    <!-- Custom site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
