@model IEnumerable<azure_fd_app_2.Models.Product>
@{
    ViewData["Title"] = "Products Collection";
}

<div class="construction-page-container">
    <div class="glass-card construction-card">
        <!-- Pulsing / Rotating Under Construction Visual -->
        <div class="construction-visual">
            <div class="glow-ring"></div>
            <div class="visual-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="construction-svg">
                    <circle cx="12" cy="12" r="3"></circle>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
                </svg>
            </div>
        </div>

        <div class="status-tag construction-status">
            <span class="status-dot warning-dot"></span>
            <span class="status-label">Maintenance / Setup Mode</span>
        </div>

        <h1 class="gradient-title">Content Hosted on Legacy Site</h1>
        
        <p class="construction-description">
            Our catalog is currently undergoing a structural update. The new premium products collection is temporarily hosted on our secure legacy server.
        </p>

        <div class="construction-actions">
            <a asp-controller="Home" asp-action="Index" class="btn btn-secondary btn-lg">
                <span>Back to Home</span>
            </a>
        </div>
    </div>
</div>

<style>
    .construction-page-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 70vh;
        padding: 40px 24px;
        background: radial-gradient(circle at center, rgba(230, 162, 60, 0.15) 0%, transparent 60%);
    }

    .construction-card {
        max-width: 600px;
        width: 100%;
        text-align: center;
        padding: 60px 40px;
        background: var(--bg-glass);
        backdrop-filter: blur(16px);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .construction-card::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
        pointer-events: none;
    }

    .construction-visual {
        position: relative;
        width: 100px;
        height: 100px;
        margin-bottom: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .construction-visual .glow-ring {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 2px dashed #e6a23c;
        opacity: 0.4;
        animation: spin 20s linear infinite;
    }

    .construction-visual .visual-icon {
        width: 70px;
        height: 70px;
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--shadow-md);
        color: #e6a23c;
        position: relative;
        z-index: 1;
        animation: pulse-glow 3s ease-in-out infinite alternate;
    }

    .construction-svg {
        width: 32px;
        height: 32px;
    }

    .construction-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        padding: 6px 16px;
        border-radius: var(--radius-pill);
        margin-bottom: 24px;
        font-size: 0.85rem;
        font-weight: 500;
        color: var(--text-secondary);
    }

    .warning-dot {
        width: 8px;
        height: 8px;
        background-color: #e6a23c;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 8px #e6a23c;
    }

    .gradient-title {
        font-size: 2.5rem;
        font-weight: 800;
        line-height: 1.2;
        margin-bottom: 20px;
        background: linear-gradient(135deg, var(--text-primary) 30%, #e6a23c);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.03em;
    }

    .construction-description {
        color: var(--text-secondary);
        font-size: 1.1rem;
        line-height: 1.7;
        margin-bottom: 36px;
        max-width: 480px;
    }

    .construction-actions .btn {
        gap: 10px;
        box-shadow: 0 10px 20px rgba(230, 162, 60, 0.15);
        transition: transform var(--transition-fast), box-shadow var(--transition-fast);
    }

    .construction-actions .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 24px rgba(230, 162, 60, 0.25);
    }

    @@keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    @@keyframes pulse-glow {
        0% {
            box-shadow: 0 0 15px rgba(230, 162, 60, 0.15);
            transform: scale(1);
        }
        100% {
            box-shadow: 0 0 25px rgba(230, 162, 60, 0.35);
            transform: scale(1.03);
        }
    }

    @@media (max-width: 576px) {
        .gradient-title {
            font-size: 2.0rem;
        }
        .construction-card {
            padding: 40px 24px;
        }
    }
</style>
